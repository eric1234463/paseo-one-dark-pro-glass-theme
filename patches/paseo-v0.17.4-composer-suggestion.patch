+test("Tab accepts a plugin's suggested prompt into an empty composer", async ({ page }) => {
+  const prompt = "Show the diff.";
+  const agent = await seedMockAgentWorkspace({
+    repoPrefix: "prompt-suggestion-",
+    title: "Prompt suggestion",
+  });
+  try {
+    await withDirectoryPlugin({
+      pluginId: "suggested-prompt",
+      source: `import { z } from "zod";
+        export default function contribute(client) {
+          return client.addTimelineRenderer({
+            kind: "follow-up", version: 1, schema: z.object({ prompt: z.string() }),
+            composerSuggestion: ({ prompt }) => prompt, Component: () => null,
+          });
+        }`,
+      serverSource: `export default function contribute(server) {
+        let suggested = false;
+        return server.addHook("agent.turn.after", async ({ agent, turnId }, { paseo }) => {
+          if (suggested) return;
+          suggested = true;
+          await paseo.agents.ref(agent.id).timeline.append({
+            type: "plugin", id: turnId, kind: "follow-up", version: 1, data: {prompt: ${JSON.stringify(prompt)}}
+          });
+        });
+      }`,
+      run: async () => {
+        await openAgentRoute(page, agent);
+        const input = page.getByRole("textbox", { name: "Message agent..." }).first();
+        await input.fill("Keep this draft");
+        await requestPluginTimeline(agent);
+        await expect(input).toHaveAttribute("placeholder", prompt);
+        await input.press("Tab");
+        await expect(input).toHaveValue("Keep this draft");
+        await input.fill("");
+        await input.press("Shift+Tab");
+        await expect(input).toHaveValue("");
+        await input.press("Tab");
+        await expect(input).toBeFocused();
+        await expect(input).toHaveValue(prompt);
+        await page.keyboard.type(" Please.");
+        await expect(input).toHaveValue(prompt + " Please.");
+        await input.press("Enter");
+        await expect(input).toHaveValue("");
+        await expect(input).not.toHaveAttribute("placeholder", prompt);
+      },
+    });
+  } finally {
+    await agent.cleanup();
+  }
+});
