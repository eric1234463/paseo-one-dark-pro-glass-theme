 import { transformTimelineItem, type TimelineItemTransform } from "./model";

 export type { InstalledPluginTimelineItem, TimelineItemTransform } from "./model";
@@ -13,3 +14,30 @@ export function useInstalledTimelineTransform(serverId: string): TimelineItemTra
   );
   return useMemo(() => (input) => transformTimelineItem({ ...input, plugins }), [plugins]);
 }
+
+export function useTimelineComposerSuggestion(serverId: string, agentId: string, enabled: boolean) {
+  const row = useSessionStore((state) => {
+    const session = state.sessions[serverId];
+    if (!enabled || !session || session.agentTimelineHasNewer.get(agentId)) return null;
+    const latest =
+      session.agentStreamHead.get(agentId)?.at(-1) ?? session.agentStreamTail.get(agentId)?.at(-1);
+    return latest?.kind === "plugin" ? latest : null;
+  });
+  const plugin = useInstalledPlugin(serverId, row?.pluginId ?? "");
+  return useMemo(() => {
+    if (!row || !plugin) return undefined;
+    const renderer = plugin.timelineRenderers.find(
+      (entry) => entry.kind === row.itemKind && entry.version === row.version,
+    );
+    if (!renderer?.composerSuggestion) return undefined;
+    try {
+      const parsed = renderer.schema.safeParse(row.data);
+      if (!parsed.success) return undefined;
+      const text = renderer.composerSuggestion(parsed.data);
+      return typeof text === "string" && text.trim() ? text : undefined;
+    } catch (error) {
+      console.warn("[Plugins] Composer suggestion failed", error);
+      return undefined;
+    }
+  }, [plugin, row]);
+}
